# eisenpaper as an always-on systemd user service.
#
# install (fills in @PROJECT_DIR@ for this checkout):
#   just install-service
# then the sheet is always at http://localhost:8741
#
# for phone access on the LAN, append  --host 0.0.0.0  to ExecStart.

[Unit]
Description=eisenpaper task sheet

[Service]
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/target/release/eisenpaper --web web/dist --data tasks.json
Restart=on-failure

[Install]
WantedBy=default.target
